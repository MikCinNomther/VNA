<UserControl x:Class="VNA.Controls.AlertTextBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:VNA.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="30" d:DesignWidth="400"
             x:Name="root">
    <!-- 添加根控件名称 -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 使用 TextBlock 显示 DialogText -->
        <TextBlock x:Name="Dialog" 
                   VerticalAlignment="Center" 
                   Margin="5,0"
                   Text="{Binding DialogText, ElementName=root}"/>

        <!-- 使用 TextBox 绑定 Text 属性 -->
        <TextBox x:Name="TextBox"
                 Grid.Column="1"
                 Margin="2"
                 VerticalAlignment="Center"
                 Text="{Binding Text, ElementName=root, UpdateSourceTrigger=PropertyChanged}"/>
    </Grid>
</UserControl>